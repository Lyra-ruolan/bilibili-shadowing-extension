{
  "manifest_version": 3,
  "name": "Shadowing Studio - 哔哩哔哩跟读实验版",
  "version": "0.1.0",
  "description": "读取哔哩哔哩英文字幕，进行整句或自然分段影子跟读，并下载字幕到本地。",
  "homepage_url": "https://github.com/refyi1698-glitch/shadowing-studio-bilibili-public",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开哔哩哔哩影子跟读侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "previous-practice-unit": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "切换到上一个练习项"
    },
    "toggle-practice-playback": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "播放或暂停当前练习项"
    },
    "next-practice-unit": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "切换到下一个练习项"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "core/bilibili.js",
        "core/sentence-segmenter.js",
        "core/playback-mode.js",
        "content/content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
